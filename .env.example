# Copy this file to .env and fill in real values. Never commit .env.
# All variables are prefixed EXPO_PUBLIC_ because they are read on the client
# (Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build time).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: this key ships inside the app bundle, so it is extractable by anyone
# with the APK/IPA. Fine for a student prototype; rotate/restrict the key or
# move generation behind a server if this ever handles real traffic.
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_API_URL=https://api.deepseek.com
